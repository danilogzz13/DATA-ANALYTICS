PO_COUNT_PREV_SNAPSHOT = 
VAR CURRENT_SNAPSHOT = [MAX_SNAPSHOT] -- LOOK MAX SNAP (CURRENT IN THIS CONTEXT)

VAR PREVIOUS_SNAPSHOT =
    CALCULATE(
        [MAX_SNAPSHOT], -- LOOK PREVIOUS SNAP
        REMOVEFILTERS(DIM_SNAPSHOTS), -- REMOVE CURRENT SNAP FILTER
        FILTER(
            ALL(FACT_DELFOR[SNAPSHOT]),
            FACT_DELFOR[SNAPSHOT] < CURRENT_SNAPSHOT -- CREATE FILTER PREVIOUS SNAP
        )
    )

RETURN
    CALCULATE(
        [PO_COUNT], -- BASE DAX
        REMOVEFILTERS(DIM_SNAPSHOTS), -- REMOVE CURRENT SNAP FILTER
        FACT_DELFOR[SNAPSHOT] = PREVIOUS_SNAPSHOT -- FILTER BY PREVIOUS SNAP
    )
